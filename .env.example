# ─────────────────────────────────────────────
# SERVICE
# ─────────────────────────────────────────────
SERVICE_NAME=ff-ingestion
ENVIRONMENT=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ─────────────────────────────────────────────
# AWS
# ─────────────────────────────────────────────
AWS_REGION=af-south-1

# Authentication — choisir une méthode pour le dev local
AWS_PROFILE=ps-test-operator

# Static credentials (alternative)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ─────────────────────────────────────────────
# SQS — Queues
# ─────────────────────────────────────────────
SQS_EMAIL_QUEUE_URL=https://sqs.af-south-1.amazonaws.com/595214630101/fairfare-box-email-ingestion
SQS_FARE_EVENT_QUEUE_URL=https://sqs.af-south-1.amazonaws.com/595214630101/fairfare-box-fareevent

# ─────────────────────────────────────────────
# SQS — Paramètres
# ─────────────────────────────────────────────
SQS_MAX_WORKERS=2
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=300
SQS_MAX_CONCURRENT_MESSAGES=10

# ─────────────────────────────────────────────
# SQS — FIFO
# ─────────────────────────────────────────────
PARSED_SQS_MESSAGE_GROUP_ID=default

# ─────────────────────────────────────────────
# OPENAI
# ─────────────────────────────────────────────
SECRETS_MANAGER_ENABLED=false
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Via AWS Secrets Manager (alternative)
# SECRETS_MANAGER_ENABLED=true
# OPENAI_SECRET_NAME=fairfare/openai-api-key

# ─────────────────────────────────────────────
# CONSUMER
# ─────────────────────────────────────────────
CONSUMER_ENABLED=true
CONSUMER_MAX_RETRIES=3
CONSUMER_ERROR_DELAY_SECONDS=5

# ─────────────────────────────────────────────
# X-RAY (observabilité AWS)
# ─────────────────────────────────────────────
ENABLE_XRAY=false
# AWS_XRAY_DAEMON_ADDRESS=127.0.0.1:2000