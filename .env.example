# ─────────────────────────────────────────────
# SERVICE
# ─────────────────────────────────────────────
SERVICE_NAME=ff-ingestion
ENVIRONMENT=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ─────────────────────────────────────────────
# AWS
# ─────────────────────────────────────────────
AWS_REGION=us-east-1

# Authentification — choisir UNE méthode pour le dev local
# (laisser vide en prod: rôles IAM ECS/EKS/EC2)
AWS_PROFILE=

# Static credentials (alternative, à éviter)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ─────────────────────────────────────────────
# SQS — Queues (à fournir par environnement)
# ─────────────────────────────────────────────
SQS_EMAIL_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>
SQS_FARE_EVENT_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>

# ─────────────────────────────────────────────
# SQS — Paramètres consumer
# ─────────────────────────────────────────────
SQS_MAX_WORKERS=2
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=300
SQS_MAX_CONCURRENT_MESSAGES=10

# Heartbeat: prolongation périodique du visibility timeout pendant le traitement
SQS_HEARTBEAT_INTERVAL_SECONDS=60
SQS_HEARTBEAT_EXTEND_SECONDS=120

# ─────────────────────────────────────────────
# SQS — FIFO (optionnel, uniquement si la queue est .fifo)
# ─────────────────────────────────────────────
PARSED_SQS_MESSAGE_GROUP_ID=default

# ─────────────────────────────────────────────
# OPENAI
# ─────────────────────────────────────────────
SECRETS_MANAGER_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2

# Via AWS Secrets Manager (alternative)
# SECRETS_MANAGER_ENABLED=true
# OPENAI_SECRET_NAME=fairfare/openai-api-key

# ─────────────────────────────────────────────
# CONSUMER
# ─────────────────────────────────────────────
CONSUMER_ENABLED=true
CONSUMER_MAX_RETRIES=3
CONSUMER_ERROR_DELAY_SECONDS=5

# ─────────────────────────────────────────────
# X-RAY (observabilité AWS)
# ─────────────────────────────────────────────
ENABLE_XRAY=false
# AWS_XRAY_DAEMON_ADDRESS=127.0.0.1:2000

# ─────────────────────────────────────────────
# LOGS
# ─────────────────────────────────────────────
# Log le contenu intégral des réponses OpenAI (DEV uniquement, peut contenir des PII)
LOG_OPENAI_PAYLOAD=false
