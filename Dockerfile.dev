# ─────────────────────────────────────────────
# DEVELOPMENT — Hot reload & dev tools
# ─────────────────────────────────────────────
FROM python:3.11

WORKDIR /app

# Dépendances système
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        git \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Dépendances Python (mode éditable + dev extras)
COPY pyproject.toml ./
COPY src/ ./src/

RUN pip install --no-cache-dir -e ".[dev]"

# Code source (surchargé par le volume mount dans docker-compose)
COPY . .

# ─────────────────────────────────────────────
# ENVIRONNEMENT
# ─────────────────────────────────────────────
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ENVIRONMENT=dev

# ─────────────────────────────────────────────
# EXPOSITION & ENTRYPOINT
# ─────────────────────────────────────────────
EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]